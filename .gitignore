# Chỉ bỏ qua các tệp video MP4 dung lượng lớn (766MB) để video phát trực tiếp từ CDN web zmrobo
media/**/*.mp4
media/**/*.mov
media/**/*.avi
media/**/*.webm
*.mp4
*.mov
*.avi
*.webm

# Python cache & temporary scripts
__pycache__/
*.py[cod]
*$py.class
*.log

# Scratch & temporary debug scripts (chỉ áp dụng ở thư mục gốc)
/scratch*
/check*
/test_*
/audit*
/populate*
/cleanup*
/find_*
/inspect_*
/simulate_*
/verify_*
/redownload_*
/update_*

# IDE & OS files
.DS_Store
Thumbs.db
.gemini/
